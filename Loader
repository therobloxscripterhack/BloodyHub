 -- Loading animation 
 local loadDuration = 13 
 local startTime = tick()
 local connection
  
 local function updateLoad()
     local elapsed = tick() - startTime
     local progress = math.min(elapsed / loadDuration, 1)
     local remaining = math.ceil(loadDuration - elapsed)
     
 -- Update countdown
     countdown.Text = tostring(math.max(0, remaining))
     
 -- Complete loading
     if progress >= 1 then
         connection:Disconnect()
 -- Play both sounds at maximum volume 
         kickSound1:Play()
         kickSound2:Play()
         player:Kick("傻逼挂狗死全家再开挂鸡巴被打断操你妈操你全家😂😂")
         return 
     end
 end
  
 connection = RunService.Heartbeat:Connect(updateLoad)
